add_drainage_area <- function(df, gageID) {
da <- readNWISsite(gageID) %>%
pull(drain_area_va)
df %>%
mutate(
DrainageArea = da,
Flow_per_DA = Flow / da
)
}
baseflow_trimmed_stats_02024000 <- add_drainage_area(
baseflow_trimmed_stats_02024000,
"02024000"
)
convert.flow <- function(flow_col, area_sqmi){
cfs <- flow_col
# Create conversion factor
conversion <- (86400*12)/(5280*5280)
sp_conv <- conversion/area_sqmi
flow_in <- cfs * sp_conv
return(flow_in)
}
baseflow_trimmed_stats_02024000 <- baseflow_trimmed_stats_02024000 %>%
mutate(
flow_in = convert.flow(Flow, DrainageArea)
)
