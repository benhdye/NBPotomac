site_factors <- function(da_sqmi, flow_vec = Qts, vec_for_reg = NULL, m, b){
Qin <- convert.flow(flow_vec, da_sqmi)
if (is.null(vec_for_reg)) {
vec_for_reg <- Qin
}
C <- b + (m * log(vec_for_reg))
C <- pmin(pmax(C, 0.001), 0.999)
assign("Qin", Qin, envir = .GlobalEnv)
assign("C",   C,   envir = .GlobalEnv)
}
site_factors(da_sqmi, flow_vec = Qts, m = m, b = b)
Qts <- seq(min(clean_maury$flow_in, na.rm=TRUE),
max(clean_maury$flow_in, na.rm=TRUE),
by = 0.001)
site_factors <- function(da_sqmi, flow_vec = Qts, vec_for_reg = NULL, m, b){
Qin <- convert.flow(flow_vec, da_sqmi)
if (is.null(vec_for_reg)) {
vec_for_reg <- Qin
}
C <- b + (m * log(vec_for_reg))
C <- pmin(pmax(C, 0.001), 0.999)
assign("Qin", Qin, envir = .GlobalEnv)
assign("C",   C,   envir = .GlobalEnv)
}
site_factors(da_sqmi, flow_vec = Qts, m = m, b = b)
S <- Qin / (1 - C)
Svar <- data.frame(
Qts = Qts,
C = C,
Qin = Qin,
S = S
)
Svar$dS <- c(Svar$S[-1] / Svar$S[-length(Svar$S)], NA)
Svar <- subset(Svar, dS > 1 & S > 0)
clean_maury$AGWS_est <- approx(
Svar$Qts,
Svar$S,
xout = clean_maury$flow_in,
rule = 2
)$y
clean_maury$AGWS_final <- ifelse(
is.na(clean_maury$AGWS),
clean_maury$AGWS_est,
clean_maury$AGWS
)
#checks
sum(is.na(clean_maury$AGWS_final))
plot(clean_maury$Date, clean_maury$AGWS_final,
type = "l", col = "blue",
xlab = "Date", ylab = "Storage (AGWS)")
points(clean_maury$Date, clean_maury$AGWS, col = "red")
legend("topright",
legend = c("AGWS Best Estimate", "Observed Baseflow Storage"),
col = c("blue", "red"),
lty = c(1, NA),
pch = c(NA, 1))
View(clean_maury)
#checks and example plots
sum(is.na(clean_maury$AGWS_final))
